{
  "name": "airic-forge",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "agent:prepare": "node apps/api/dist/forge-ops.js prepare",
    "agent:check": "node apps/api/dist/forge-ops.js check",
    "instance:init": "node apps/api/dist/forge-ops.js init",
    "dev": "pnpm --filter @airic-forge/api dev",
    "test:e2e": "pnpm --filter @airic-forge/workbench test:e2e",
    "user:set-password": "node --env-file-if-exists=.env apps/api/dist/set-user-password-cli.js"
  },
  "pnpm": {
    "overrides": {
      "react-is": "18.3.1"
    }
  }
}
