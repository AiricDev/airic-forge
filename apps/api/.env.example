FORGE_PORT=4175
FORGE_PROJECT_DIR=./runtime/certlab/project
FORGE_DATA_DIR=./runtime/certlab/data
FORGE_WEB_DIST_DIR=./apps/workbench/public
FORGE_CERTLAB_URL=http://127.0.0.1:8000
FORGE_ORGANIZATION_ID=
FORGE_ALLOWED_ORIGIN=http://127.0.0.1:5173
FORGE_MODEL_PROVIDER=
FORGE_MODEL_ID=
FORGE_MODEL_API_KEY=
FORGE_MODEL_BASE_URL=
FORGE_CONTEXT_OUTPUT_TOKENS=8000

# App-owned native Pi settings: <absolute-directory>/{work,reflection}/settings.json
FORGE_AGENT_CONFIG_DIR=
# Prepared dependencies and immutable per-run resource snapshots (not OM)
FORGE_AGENT_CACHE_DIR=
# Release image digest; source mode computes a code identity when omitted
FORGE_DEPLOYMENT_ID=
# Comma-separated required native programs; default git
FORGE_REQUIRED_PROGRAMS=git
