# Pin a CertReporter image that includes the Forge Report Drawer and /airic/v1 protocol.
CERTREPORTER_IMAGE=replace-with-compatible-pinned-image
DJANGO_SECRET_KEY=replace-with-a-persistent-random-secret
FORGE_INITIAL_ADMIN_EMAILS=
FORGE_MODEL_PROVIDER=
FORGE_MODEL_ID=
FORGE_MODEL_API_KEY=
FORGE_MODEL_BASE_URL=
# Optional localhost port overrides for an isolated rehearsal.
CERTREPORTER_HOST_PORT=3000
FORGE_HOST_PORT=4175
CERTREPORTER_PUBLIC_ORIGIN=http://localhost:3000
FORGE_PUBLIC_URL=http://localhost:4175
# Keep this at ./state for scripts/backup-p0.sh; override only for restore rehearsals.
P0_STATE_ROOT=./state
